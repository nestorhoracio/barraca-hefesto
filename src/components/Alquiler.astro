---
import AndamioSvg from '../assets/icons/Andamio.svg?raw';
import CarpaSvg   from '../assets/icons/Carpa.svg?raw';

const WHATSAPP = import.meta.env.WHATSAPP_NUMBER ?? '59899096947';

const items = [
  {
    icono: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>',
    titulo: 'Herramientas',
    desc: 'Taladros, amoladoras, hormigoneras, compresores y más. Disponibles por día o semana.',
    wa: 'Hola Hefesto, quiero consultar por alquiler de herramientas.',
  },
  {
    icono: CarpaSvg,
    titulo: 'Carpas',
    desc: 'Carpas de distintos tamaños para eventos, fiestas y obras. Consulte disponibilidad.',
    wa: 'Hola Hefesto, quiero consultar por alquiler de carpas.',
  },
  {
    icono: AndamioSvg,
    titulo: 'Andamios',
    desc: 'Andamios seguros y certificados para trabajos en altura. Armado y desarmado incluido.',
    wa: 'Hola Hefesto, quiero consultar por alquiler de andamios.',
  },
];

const pasos = [
  { num: '01', titulo: 'Consultá', desc: 'Contanos qué equipo necesitás y por cuánto tiempo.' },
  { num: '02', titulo: 'Reservá', desc: 'Te confirmamos disponibilidad y coordinamos el retiro o la entrega.' },
  { num: '03', titulo: 'Retirá', desc: 'Pasás por nuestro local o te lo llevamos a donde lo necesites.' },
  { num: '04', titulo: 'Devolvé', desc: 'Al finalizar, coordinamos la devolución de forma simple y rápida.' },
];

const condiciones = [
  {
    titulo: 'Plazos',
    desc: 'Las herramientas se alquilan por 24 hs. Los andamios, por semana. Las herramientas grandes de construcción se pueden alquilar por mes.',
  },
  {
    titulo: 'Pago',
    desc: 'Se abona el total del alquiler al momento de retirar, con precio diferenciado entre lo que se retira en la barraca y lo que Hefesto lleva y trae.',
  },
  {
    titulo: 'Requisitos',
    desc: 'Cédula, teléfono y dirección.',
  },
];

const carpasTamanos = ['12 × 6 m', '6 × 8 m (octogonal)', '6 × 3 m'];

const catalogo = [
  {
    categoria: 'Demolición y perforación',
    items: ['Martillo demoledor 15 kg', 'Martillo demoledor 30 kg', 'Rotomartillo', 'Taladros eléctricos', 'Barra'],
  },
  {
    categoria: 'Corte y desbaste',
    items: ['Amoladora ¼', 'Amoladora 9"', 'Acanaladora', 'Cortadora de metal', 'Cortadora de cerámica', 'Cepillo circular', 'Caladora', 'Fresadora', 'Lijadora'],
  },
  {
    categoria: 'Hormigón y nivelación',
    items: ['Hormigonera', 'Regla vibradora', 'Vibrador', 'Helicóptero (alisadora)', 'Nivelador de placas', 'Plancha compactadora', 'Pata Pata', 'Nivel láser', 'Nivel óptico'],
  },
  {
    categoria: 'Andamios y trabajo en altura',
    items: ['Andamios', 'Tirantes', 'Puntales', 'Barandas', 'Escaleras', 'Tablones', 'Cinto de seguridad', 'Casco', 'Nudos móviles', 'Vientos', 'Ruedas', 'Niveladores'],
  },
  {
    categoria: 'Soldadura y terminaciones',
    items: ['Soldadora', 'Careta de soldador', 'Termofusora', 'Pistola de silicona', 'Pistola de proyectar', 'Pistola de poliuretano', 'Plegadora de canalón', 'Equipo airless'],
  },
  {
    categoria: 'Energía e iluminación',
    items: ['Generador', 'Compresor', 'Alargues', 'Focos de luz'],
  },
  {
    categoria: 'Transporte y elevación',
    items: ['Montacargas', 'Lagarto', 'Carretillas', 'Pallets', 'Gatos hidráulicos'],
  },
  {
    categoria: 'Jardín y exteriores',
    items: ['Desmalezadora', 'Cortacésped', 'Motosierra', 'Multiherramienta 4 en 1', 'Hoyadora', 'Pala poceadora'],
  },
  {
    categoria: 'Eventos',
    items: ['Carpas', 'Tarimas', 'Escenario', 'Parrillero'],
  },
  {
    categoria: 'Varios de obra',
    items: ['Chapones', 'Tarrinas', 'Palas', 'Baldes', 'Mangueras', 'Engrapadora', 'Aspiradora', 'Motobomba'],
  },
];
---

<section id="alquiler" class="section">
  <div class="container">

    <h2 class="section-title">Alquiler</h2>
    <p class="section-subtitle">Alquiler de herramientas, carpas y andamios en Paso de los Toros. Consultá disponibilidad.</p>

    <div class="alquiler__grid">
      {items.map(item => (
        <div class="alq-card">
          <div class="alq-card__icon" set:html={item.icono}></div>
          <h3 class="alq-card__title">{item.titulo}</h3>
          <p class="alq-card__desc">{item.desc}</p>

           <a href={`https://wa.me/${WHATSAPP}?text=${encodeURIComponent(item.wa)}`}
  target="_blank"
  rel="noopener noreferrer"
  class="btn btn-whatsapp alq-card__btn"
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
    <path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.535 5.858L.057 23.427a.75.75 0 0 0 .916.916l5.569-1.478A11.95 11.95 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.907 0-3.7-.512-5.243-1.406l-.376-.222-3.896 1.033 1.033-3.896-.222-.376A9.956 9.956 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
  </svg>
  Consultar por WhatsApp
</a>
        </div>
      ))}
    </div>

    <div class="pasos">
      <h3 class="pasos__titulo">¿Cómo funciona?</h3>
      <div class="pasos__grid">
        {pasos.map(paso => (
          <div class="paso">
            <span class="paso__num">{paso.num}</span>
            <h4 class="paso__titulo">{paso.titulo}</h4>
            <p class="paso__desc">{paso.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="condiciones">
      <h3 class="condiciones__titulo">Condiciones de alquiler</h3>
      <div class="condiciones__grid">
        {condiciones.map(c => (
          <div class="condicion">
            <h4 class="condicion__titulo">{c.titulo}</h4>
            <p class="condicion__desc">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="carpas-info">
      <h3 class="carpas-info__titulo">Tamaños de carpas</h3>
      <div class="carpas-info__tamanos">
        {carpasTamanos.map(t => <span class="tamano">{t}</span>)}
      </div>
      <p class="carpas-info__desc">
        El armado, desarmado y traslado dentro de Paso de los Toros están incluidos. Para otras localidades se cobra el costo del viaje. No hace falta reservar con anticipación mínima, aunque por costumbre la mayoría reserva con tiempo.
      </p>
    </div>

    <div class="catalogo">
      <h3 class="catalogo__titulo">Catálogo de herramientas</h3>
      <p class="catalogo__subtitulo">Más de 80 herramientas y equipos disponibles, organizados por categoría.</p>
      <div class="catalogo__grid">
        {catalogo.map(cat => (
          <div class="catalogo__cat">
            <h4 class="catalogo__cat-titulo">{cat.categoria}</h4>
            <div class="catalogo__tags">
              {cat.items.map(item => <span class="tag">{item}</span>)}
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
<style>
  .alquiler__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .alq-card {
    background: var(--color-gray-1);
    border: 1px solid var(--color-gray-2);
    border-radius: var(--radius-lg);
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .alq-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .alq-card__icon {
    width: 52px;
    height: 52px;
    background: var(--color-brand-bg);
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-brand);
    margin-bottom: 0.25rem;
  }

  .alq-card__title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-black);
  }

  .alq-card__desc {
    font-size: 0.9rem;
    color: var(--color-gray-4);
    line-height: 1.6;
    flex: 1;
  }

  .alq-card__btn {
    justify-content: center;
    margin-top: 0.5rem;
    font-size: 0.875rem;
  }

  /* Pasos */
  .pasos {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-gray-2);
  }

  .pasos__titulo {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--color-black);
    margin-bottom: 2rem;
    text-align: center;
  }

  .pasos__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .paso {
    text-align: center;
  }

  .paso__num {
    display: inline-block;
    font-size: 2.5rem;
    font-weight: 900;
    color: var(--color-brand);
    opacity: 0.25;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .paso__titulo {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-black);
    margin-bottom: 0.4rem;
  }

  .paso__desc {
    font-size: 0.875rem;
    color: var(--color-gray-4);
    line-height: 1.6;
  }

  /* Condiciones */
  .condiciones {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-gray-2);
  }

  .condiciones__titulo {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--color-black);
    margin-bottom: 2rem;
    text-align: center;
  }

  .condiciones__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .condicion {
    background: var(--color-gray-1);
    border: 1px solid var(--color-gray-2);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }

  .condicion__titulo {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-brand);
    margin-bottom: 0.5rem;
  }

  .condicion__desc {
    font-size: 0.875rem;
    color: var(--color-gray-4);
    line-height: 1.6;
  }

  /* Carpas info */
  .carpas-info {
    margin-top: 3rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-gray-2);
  }

  .carpas-info__titulo {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--color-black);
    margin-bottom: 1.25rem;
    text-align: center;
  }

  .carpas-info__tamanos {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .tamano {
    display: inline-block;
    padding: 0.45rem 1.1rem;
    background: var(--color-brand-bg);
    color: var(--color-brand);
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .carpas-info__desc {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
    font-size: 0.9rem;
    color: var(--color-gray-4);
    line-height: 1.6;
  }

  /* Catálogo */
  .catalogo {
    margin-top: 3rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-gray-2);
  }

  .catalogo__titulo {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--color-black);
    margin-bottom: 0.5rem;
    text-align: center;
  }

  .catalogo__subtitulo {
    font-size: 0.9rem;
    color: var(--color-gray-4);
    text-align: center;
    margin-bottom: 2rem;
  }

  .catalogo__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .catalogo__cat {
    background: var(--color-gray-1);
    border: 1px solid var(--color-gray-2);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
  }

  .catalogo__cat-titulo {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-black);
    margin-bottom: 0.75rem;
  }

  .catalogo__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    display: inline-block;
    padding: 0.3rem 0.7rem;
    background: var(--color-white);
    border: 1px solid var(--color-gray-2);
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    color: var(--color-gray-5);
  }

  @media (max-width: 768px) {
    .alquiler__grid       { grid-template-columns: 1fr; }
    .pasos__grid          { grid-template-columns: 1fr; gap: 1.5rem; }
    .condiciones__grid    { grid-template-columns: 1fr; }
    .catalogo__grid       { grid-template-columns: 1fr; }
  }
</style>
