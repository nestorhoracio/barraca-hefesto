---
const WHATSAPP = import.meta.env.WHATSAPP_NUMBER ?? '59899096947';
---

<section id="contacto" class="section section--gray">
  <div class="container">

    <h2 class="section-title">Contacto y ubicación</h2>
    <p class="section-subtitle">Estamos en el centro de Paso de los Toros, listos para atenderte.</p>

    <div class="contacto__grid">

      <!-- Info -->
      <div class="contacto__info">

        <div class="info-item">
          <div class="info-item__icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </div>
          <div>
            <p class="info-item__label">Dirección</p>
            <p class="info-item__value">18 de Julio 1097 esq. Pedro Mª Chiesa</p>
            <p class="info-item__value">Paso de los Toros, Tacuarembó</p>
          </div>
        </div>

        <div class="info-item">
          <div class="info-item__icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/>
              <line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
          </div>
          <div>
            <p class="info-item__label">Horarios</p>
            <p class="info-item__value">Lunes a viernes: 8:00 – 18:30</p>
            <p class="info-item__value">Sábados: 8:00 – 12:00</p>
            <p class="info-item__value">Domingos y feriados no laborables: Cerrado</p>
            <p class="info-item__value" style="font-size:0.82rem;color:var(--color-gray-4);">Feriados laborables: horario habitual</p>
          </div>
        </div>

        <div class="info-item">
          <div class="info-item__icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
              <path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.535 5.858L.057 23.427a.75.75 0 0 0 .916.916l5.569-1.478A11.95 11.95 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.907 0-3.7-.512-5.243-1.406l-.376-.222-3.896 1.033 1.033-3.896-.222-.376A9.956 9.956 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
            </svg>
          </div>
          <div>
            <p class="info-item__label">WhatsApp</p>
            <a href={`https://wa.me/${WHATSAPP}`} target="_blank" rel="noopener noreferrer"
               class="info-item__link">Escribinos ahora</a>
          </div>
        </div>

        <div class="info-item">
          <div class="info-item__icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </div>
          <div>
            <p class="info-item__label">Correo</p>
            <a href="mailto:hefestobarraca@gmail.com" class="info-item__link">hefestobarraca@gmail.com</a>
          </div>
        </div>

        <div class="info-item">
          <div class="info-item__icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/>
            </svg>
          </div>
          <div>
            <p class="info-item__label">Instagram</p>
            <a href="https://www.instagram.com/barraca.hefesto/" target="_blank"
               rel="noopener noreferrer" class="info-item__link">@barraca.hefesto</a><br />
            <a href="https://www.instagram.com/hefesto.alquileres/" target="_blank"
               rel="noopener noreferrer" class="info-item__link">@hefesto.alquileres (Alquileres)</a>
          </div>
        </div>

        <div class="info-item">
          <div class="info-item__icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
          </div>
          <div>
            <p class="info-item__label">Facebook</p>
            <a href="https://www.facebook.com/barracahefesto" target="_blank"
               rel="noopener noreferrer" class="info-item__link">Barraca Hefesto</a>
          </div>
        </div>

      </div>

      <!-- Mapa -->
      <div class="contacto__mapa">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d5639.518182527289!2d-56.526744030475605!3d-32.81140958843197!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95a64158ff30ca7d%3A0x4b6b12fd293ec14f!2sBarraca%20Hefesto!5e0!3m2!1ses-419!2suy!4v1777726452635!5m2!1ses-419!2suy" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>

    </div>
  </div>
</section>
<style>
  .contacto__grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 3rem;
    margin-top: 2.5rem;
    align-items: start;
  }

  /* Info items */
  .info-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.25rem;
    background: var(--color-white);
    border: 1px solid var(--color-gray-2);
    border-radius: var(--radius-md);
    margin-bottom: 1rem;
  }

  .info-item__icon {
    width: 40px;
    height: 40px;
    background: var(--color-brand-bg);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-brand);
    flex-shrink: 0;
  }

  .info-item__label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-gray-4);
    margin-bottom: 0.25rem;
  }

  .info-item__value {
    font-size: 0.95rem;
    color: var(--color-black);
    line-height: 1.5;
  }

  .info-item__link {
    font-size: 0.95rem;
    color: var(--color-brand);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .info-item__link:hover { color: var(--color-brand-dark); }

  /* Mapa */
  .contacto__mapa {
    border-radius: var(--radius-lg);
    overflow: hidden;
    height: 420px;
    border: 1px solid var(--color-gray-2);
    box-shadow: var(--shadow-sm);
  }

  .contacto__mapa iframe {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 768px) {
    .contacto__grid {
      grid-template-columns: 1fr;
    }
    .contacto__mapa { height: 300px; }
  }
</style>