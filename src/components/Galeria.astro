---
import { Image } from 'astro:assets';
import chapasOnduladas from '../assets/images/galeria/Chapas-onduladas.webp';
import chapasTrapezoidales from '../assets/images/galeria/Chapas-trapezoidal-acanaladas.webp';
import chapasTrapezoidales2 from '../assets/images/galeria/Chapas-trapezoidal-acanaladas-2.webp';
import chapasOsb from '../assets/images/galeria/chapas-osb.webp';
import chapasYeso from '../assets/images/galeria/chapas-yeso.webp';
import chapasYeso2 from '../assets/images/galeria/chapas-yeso-2.webp';
import perfiles from '../assets/images/galeria/Perfiles.webp';
import perfilesYeso from '../assets/images/galeria/Perfiles-yeso.webp';
import canosPvc from '../assets/images/galeria/Caños-pvc.webp';
import varillasCorrugadas from '../assets/images/galeria/varillas-corrugadas.webp';
import tejidoElectrosoldado from '../assets/images/galeria/tejido-electrosoldado.webp';
import mallaHormigon from '../assets/images/galeria/malla-hormigon.webp';
import alambreAtillo from '../assets/images/galeria/alambre-atillo.webp';
import alambreRecocido from '../assets/images/galeria/alambre-recocido.webp';
import bloquesHormigon from '../assets/images/galeria/bloques-hormigon.webp';
import ticholo from '../assets/images/galeria/ticholo.webp';
import arena from '../assets/images/galeria/arena.webp';

const fotos = [
  { img: chapasOnduladas, alt: 'Chapas onduladas Hefesto' },
  { img: chapasTrapezoidales, alt: 'Chapas trapezoidales acanaladas Hefesto' },
  { img: chapasTrapezoidales2, alt: 'Chapas trapezoidales acanaladas Hefesto, vista de detalle' },
  { img: chapasOsb, alt: 'Chapas OSB Hefesto' },
  { img: chapasYeso, alt: 'Chapas de yeso Hefesto' },
  { img: chapasYeso2, alt: 'Chapas de yeso Hefesto, vista de detalle' },
  { img: perfiles, alt: 'Perfiles de hierro Hefesto' },
  { img: perfilesYeso, alt: 'Perfiles de yeso Hefesto' },
  { img: canosPvc, alt: 'Caños de PVC Hefesto' },
  { img: varillasCorrugadas, alt: 'Varillas corrugadas Hefesto' },
  { img: tejidoElectrosoldado, alt: 'Tejido electrosoldado Hefesto' },
  { img: mallaHormigon, alt: 'Malla para hormigón Hefesto' },
  { img: alambreAtillo, alt: 'Alambre de atillo Hefesto' },
  { img: alambreRecocido, alt: 'Alambre recocido Hefesto' },
  { img: bloquesHormigon, alt: 'Bloques de hormigón Hefesto' },
  { img: ticholo, alt: 'Ticholo Hefesto' },
  { img: arena, alt: 'Arena Hefesto' },
];
---

<section id="galeria" class="section section--gray">
  <div class="container">
    <h2 class="section-title">Galería</h2>
    <p class="section-subtitle">Productos y obras realizadas con materiales Hefesto.</p>

    <div class="galeria__grid">
      {fotos.map((foto, i) => (
        <div class="galeria__item">
          <Image src={foto.img} alt={foto.alt} loading="lazy" format="webp" quality={75} width={i === 0 ? 1100 : 600} />
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .galeria__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  .galeria__item {
    overflow: hidden;
    border-radius: var(--radius-md);
    aspect-ratio: 1 / 1;
    background: var(--color-gray-2);
  }

  .galeria__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
    display: block;
  }

  .galeria__item:hover img {
    transform: scale(1.05);
  }

  /* Primeras dos fotos ocupan más espacio */
  .galeria__item:nth-child(1) {
    grid-column: span 2;
    grid-row: span 2;
    aspect-ratio: auto;
  }

  @media (max-width: 768px) {
    .galeria__grid { grid-template-columns: repeat(2, 1fr); }
    .galeria__item:nth-child(1) {
      grid-column: span 2;
      grid-row: span 1;
    }
  }

  @media (max-width: 480px) {
    .galeria__grid { grid-template-columns: 1fr; }
    .galeria__item:nth-child(1) { grid-column: span 1; }
  }
</style>