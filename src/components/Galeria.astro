---
import { Image } from 'astro:assets';
import foto01 from '../assets/images/galeria/foto-01.jpg';
import foto02 from '../assets/images/galeria/foto-02.jpg';
import foto03 from '../assets/images/galeria/foto-03.jpg';
import foto04 from '../assets/images/galeria/foto-04.jpg';
import foto05 from '../assets/images/galeria/foto-05.jpg';
import foto06 from '../assets/images/galeria/foto-06.jpg';
import foto07 from '../assets/images/galeria/foto-07.jpg';
import foto08 from '../assets/images/galeria/foto-08.jpg';

const fotos = [
  { img: foto01, alt: 'Materiales de construcción Hefesto' },
  { img: foto02, alt: 'Venta de chapas y perfiles Hefesto, Paso de los Toros' },
  { img: foto03, alt: 'Aberturas Hefesto' },
  { img: foto04, alt: 'Pinturería Hefesto' },
  { img: foto05, alt: 'Alquiler de herramientas Hefesto' },
  { img: foto06, alt: 'Alquiler de carpas Hefesto' },
  { img: foto07, alt: 'Andamios Hefesto' },
  { img: foto08, alt: 'Barraca Hefesto' },
];
---

<section id="galeria" class="section section--gray">
  <div class="container">
    <h2 class="section-title">Galería</h2>
    <p class="section-subtitle">Productos y obras realizadas con materiales Hefesto.</p>

    <div class="galeria__grid">
      {fotos.map(foto => (
        <div class="galeria__item">
          <Image src={foto.img} alt={foto.alt} loading="lazy" format="webp" quality={75} />
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .galeria__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  .galeria__item {
    overflow: hidden;
    border-radius: var(--radius-md);
    aspect-ratio: 1 / 1;
    background: var(--color-gray-2);
  }

  .galeria__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
    display: block;
  }

  .galeria__item:hover img {
    transform: scale(1.05);
  }

  /* Primeras dos fotos ocupan más espacio */
  .galeria__item:nth-child(1) {
    grid-column: span 2;
    grid-row: span 2;
    aspect-ratio: auto;
  }

  @media (max-width: 768px) {
    .galeria__grid { grid-template-columns: repeat(2, 1fr); }
    .galeria__item:nth-child(1) {
      grid-column: span 2;
      grid-row: span 1;
    }
  }

  @media (max-width: 480px) {
    .galeria__grid { grid-template-columns: 1fr; }
    .galeria__item:nth-child(1) { grid-column: span 1; }
  }
</style>