---
import ParedSvg     from '../assets/icons/Pared.svg?raw';
import CamionSvg    from '../assets/icons/Camion.svg?raw';
import PuertaSvg    from '../assets/icons/Puerta.svg?raw';
import RodilloSvg   from '../assets/icons/Rodillo.svg?raw';
import MartilloSvg  from '../assets/icons/Martillo.svg?raw';
import AndamioSvg   from '../assets/icons/Andamio.svg?raw';
import CarpaSvg     from '../assets/icons/Carpa.svg?raw';
const servicios = [
  { titulo: 'Materiales de construcción', desc: 'Venta de materiales de construcción en Paso de los Toros, desde los cimientos.', icono: ParedSvg },
  { titulo: 'Chapas, caños y perfiles', desc: 'Venta de chapas onduladas y trapezoidales, caños y perfiles de hierro para techos y estructuras.', icono: CamionSvg },
  { titulo: 'Aberturas', desc: 'Puertas y ventanas para todo tipo de proyecto.', icono: PuertaSvg },
  { titulo: 'Pinturería', desc: 'Línea completa Sinteplast: látex, esmaltes, membranas, texturados, selladores, barnices y más, con todos los accesorios.', icono: RodilloSvg },
  { titulo: 'Alquiler de herramientas', desc: 'Herramientas profesionales disponibles por día o semana.', icono: MartilloSvg },
  { titulo: 'Alquiler de carpas', desc: 'Carpas de distintos tamaños para eventos y obras.', icono: CarpaSvg },
  { titulo: 'Andamios', desc: 'Andamios seguros en alquiler para trabajos en altura.', icono: AndamioSvg },
];
---

<section id="servicios" class="section">
  <div class="container">
    <h2 class="section-title">Nuestros servicios</h2>
    <p class="section-subtitle">Todo lo que necesitás para tu proyecto, en un solo lugar en Paso de los Toros.</p>
    <div class="servicios__grid">
      {servicios.map(s => (
        <div class="card">
          <div class="card__icon" set:html={s.icono}></div>
          <h3 class="card__title">{s.titulo}</h3>
          <p class="card__desc">{s.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .servicios__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  .card {
    background: var(--color-gray-1);
    border: 1px solid var(--color-gray-2);
    border-radius: var(--radius-lg);
    padding: 1.75rem 1.5rem;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-brand-light);
  }

  .card__icon {
    width: 48px;
    height: 48px;
    background: var(--color-brand-bg);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    color: var(--color-brand);
  }

  .card__title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-black);
    margin-bottom: 0.4rem;
  }

  .card__desc {
    font-size: 0.875rem;
    color: var(--color-gray-4);
    line-height: 1.5;
  }

  /* La 7ma card sola en segunda fila — centrada */
  .card:last-child {
  grid-column: 2 / 3;
}

  @media (max-width: 900px) {
    .servicios__grid { grid-template-columns: repeat(2, 1fr); }
    .card:last-child  { grid-column: auto; }
  }

  @media (max-width: 520px) {
    .servicios__grid { grid-template-columns: 1fr; }
  }
</style>