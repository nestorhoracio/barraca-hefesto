---
import logoBlanco from '../assets/images/Hefesto_LogoBlanco.png';
import isotipo from '../assets/images/Hefesto_Isotipo.png';
const WHATSAPP = import.meta.env.WHATSAPP_NUMBER ?? '59899096947';
---

<!-- Botón flotante -->
<button class="asistente__btn" id="asistente-btn" aria-label="Abrir asistente">
  <img src={isotipo.src} alt="" class="asistente__btn-icon" width="32" height="32" />
</button>

<!-- Panel del chat -->
<div class="asistente__panel" id="asistente-panel" aria-hidden="true">
  <div class="asistente__header">
    <div class="asistente__header-info">
      <div class="asistente__avatar">
        <img src={logoBlanco.src} alt="Hefesto" class="asistente__avatar-img" width="22" height="22" />
      </div>
      <div>
        <p class="asistente__nombre">Asistente Hefesto</p>
        <p class="asistente__estado">En línea</p>
      </div>
    </div>
    <button class="asistente__cerrar" id="asistente-cerrar" aria-label="Cerrar">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <p class="asistente__disclaimer">Este asistente usa inteligencia artificial y puede cometer errores.</p>

  <div class="asistente__mensajes" id="asistente-mensajes">
    <div class="mensaje mensaje--bot">
      <p>¡Hola! Soy el asistente de Barraca Hefesto. Contame qué necesitás y te armo la consulta para enviarnos por WhatsApp. 🏗️</p>
    </div>
  </div>

  <div class="asistente__input-area">
    <textarea
      class="asistente__input"
      id="asistente-input"
      placeholder="Ej: Necesito chapas para un techo de 40m²..."
      rows="2"
    ></textarea>
    <button class="asistente__enviar" id="asistente-enviar">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="22" y1="2" x2="11" y2="13"/>
        <polygon points="22 2 15 22 11 13 2 9 22 2"/>
      </svg>
    </button>
  </div>
</div>
<style>
  /* Botón flotante */
  .asistente__btn {
    position: fixed;
    bottom: 1.75rem;
    right: 1.75rem;
    z-index: 200;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-brand);
    color: white;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px rgba(204, 51, 204, 0.4);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .asistente__btn:hover {
    transform: scale(1.08);
    box-shadow: 0 6px 24px rgba(204, 51, 204, 0.5);
  }
  .asistente__btn-icon {
    width: 32px;
    height: 32px;
    object-fit: contain;
  }

  /* Panel */
  .asistente__panel {
    position: fixed;
    bottom: 5.5rem;
    right: 1.75rem;
    z-index: 200;
    width: 340px;
    background: var(--color-white);
    border: 1px solid var(--color-gray-2);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform: scale(0.95) translateY(10px);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.2s, opacity 0.2s;
  }
  .asistente__panel.open {
    transform: scale(1) translateY(0);
    opacity: 1;
    pointer-events: all;
  }

  /* Header */
  .asistente__header {
    background: var(--color-brand);
    color: white;
    padding: 0.85rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .asistente__header-info {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .asistente__avatar {
    width: 36px;
    height: 36px;
    background: rgba(255,255,255,0.25);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1rem;
  }
  .asistente__avatar-img {
    width: 22px;
    height: 22px;
    object-fit: contain;
  }
  .asistente__nombre {
    font-weight: 600;
    font-size: 0.9rem;
  }
  .asistente__estado {
    font-size: 0.75rem;
    opacity: 0.85;
  }
  .asistente__cerrar {
    background: none;
    border: none;
    color: white;
    cursor: pointer;
    padding: 4px;
    opacity: 0.8;
    transition: opacity 0.15s;
  }
  .asistente__cerrar:hover { opacity: 1; }

  /* Disclaimer IA */
  .asistente__disclaimer {
    font-size: 0.7rem;
    color: var(--color-gray-4);
    text-align: center;
    padding: 0.4rem 0.75rem;
    background: var(--color-gray-1);
    border-bottom: 1px solid var(--color-gray-2);
  }

  /* Mensajes */
  .asistente__mensajes {
    padding: 1rem;
    height: 240px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: var(--color-gray-1);
  }
  /* :global() porque estos mensajes se crean con document.createElement() en
     el script del cliente — Astro solo aplica el scope automático a elementos
     presentes en el template al compilar, no a los que arma el JS en runtime */
  :global(.mensaje) {
    max-width: 85%;
    padding: 0.65rem 0.9rem;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    line-height: 1.5;
    position: relative;
  }
  :global(.mensaje--bot),
  :global(.mensaje--cargando) {
    background: var(--color-white);
    border: 1.5px solid var(--color-gray-3);
    border-bottom-left-radius: 4px;
    align-self: flex-start;
    color: var(--color-black);
  }
  /* "cola" de burbuja apuntando a la izquierda, para reforzar de qué lado viene el mensaje */
  :global(.mensaje--bot)::before,
  :global(.mensaje--cargando)::before {
    content: '';
    position: absolute;
    left: -7px;
    bottom: 0;
    width: 0;
    height: 0;
    border: 7px solid transparent;
    border-right-color: var(--color-gray-3);
    border-bottom: 0;
  }
  :global(.mensaje--bot)::after,
  :global(.mensaje--cargando)::after {
    content: '';
    position: absolute;
    left: -5.5px;
    bottom: 1px;
    width: 0;
    height: 0;
    border: 6px solid transparent;
    border-right-color: var(--color-white);
    border-bottom: 0;
  }
  :global(.mensaje--usuario) {
    background: var(--color-brand);
    color: white;
    border-bottom-right-radius: 4px;
    align-self: flex-end;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
  }
  /* "cola" de burbuja apuntando a la derecha */
  :global(.mensaje--usuario)::after {
    content: '';
    position: absolute;
    right: -6px;
    bottom: 0;
    width: 0;
    height: 0;
    border: 6px solid transparent;
    border-left-color: var(--color-brand);
    border-bottom: 0;
  }
  :global(.mensaje--cargando) {
    color: var(--color-gray-4);
    font-style: italic;
  }

  /* Input */
  .asistente__input-area {
    display: flex;
    gap: 0.5rem;
    padding: 0.75rem;
    border-top: 1px solid var(--color-gray-2);
    background: var(--color-white);
    align-items: flex-end;
  }
  .asistente__input {
    flex: 1;
    border: 1px solid var(--color-gray-2);
    border-radius: var(--radius-md);
    padding: 0.6rem 0.75rem;
    font-size: 0.875rem;
    resize: none;
    font-family: var(--font-sans);
    color: var(--color-black);
    background: var(--color-white);
    transition: border-color 0.15s;
  }
  .asistente__input:focus {
    outline: none;
    border-color: var(--color-brand);
  }
  .asistente__enviar {
    width: 36px;
    height: 36px;
    background: var(--color-brand);
    color: white;
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background 0.15s;
  }
  .asistente__enviar:hover { background: var(--color-brand-dark); }

  @media (max-width: 400px) {
    .asistente__panel { width: calc(100vw - 2rem); right: 1rem; }
  }
</style>
<script>
  const btn      = document.getElementById('asistente-btn');
  const panel    = document.getElementById('asistente-panel');
  const cerrar   = document.getElementById('asistente-cerrar');
  const input    = document.getElementById('asistente-input') as HTMLTextAreaElement | null;
  const enviar   = document.getElementById('asistente-enviar');
  const mensajes = document.getElementById('asistente-mensajes');
  const WHATSAPP = '59899096947';

  const historial: { role: 'user' | 'assistant'; content: string }[] = [];

  let userInteracted = false;

  btn?.addEventListener('click', () => {
    userInteracted = true;
    panel?.classList.toggle('open');
    panel?.setAttribute('aria-hidden', panel.classList.contains('open') ? 'false' : 'true');
  });

  cerrar?.addEventListener('click', () => {
    userInteracted = true;
    panel?.classList.remove('open');
    panel?.setAttribute('aria-hidden', 'true');
  });

  setTimeout(() => {
    if (userInteracted) return;
    panel?.classList.add('open');
    panel?.setAttribute('aria-hidden', 'false');
  }, 15000);

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function limpiarTexto(s: string): string {
    // corta en el primer separador markdown (---, ***, ___) en línea propia:
    // el modelo a veces lo usa para separar un comentario de cierre que no es
    // parte del mensaje real, y eso nunca aparecería en un mensaje al cliente
    const soloContenido = s.split(/\n[ \t]*(?:-{3,}|\*{3,}|_{3,})[ \t]*\n/)[0];
    // saca asteriscos/backticks/guiones bajos sueltos al principio y al final
    // (ej. si el modelo escribió **MENSAJE_WA:** en vez de MENSAJE_WA: en texto plano)
    return soloContenido.replace(/^[\s*_`>]+|[\s*_`]+$/g, '');
  }

  function agregarMensaje(texto: string, tipo: 'bot' | 'usuario' | 'cargando', html = false): HTMLDivElement {
    const div = document.createElement('div');
    div.className = `mensaje mensaje--${tipo}`;
    if (html) div.innerHTML = texto;
    else div.textContent = texto;
    mensajes?.appendChild(div);
    mensajes?.scrollTo({ top: mensajes.scrollHeight, behavior: 'smooth' });
    return div;
  }

  async function enviarMensaje() {
    const texto = input?.value.trim();
    if (!texto) return;

    agregarMensaje(texto, 'usuario');
    if (input) input.value = '';

    historial.push({ role: 'user', content: texto });

    const cargando = agregarMensaje('Analizando tu consulta...', 'cargando');

    try {
      const res  = await fetch('/api/asistente', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ mensajes: historial }),
      });
      const data = await res.json();
      cargando.remove();

      const respuesta: string = data.respuesta ?? '';
      historial.push({ role: 'assistant', content: respuesta });

      const esPregunta  = respuesta.startsWith('PREGUNTA:');
      const tieneResumen = respuesta.includes('RESUMEN:');

      if (esPregunta) {
        const pregunta = respuesta.replace('PREGUNTA:', '').trim();
        agregarMensaje(pregunta, 'bot');

      } else if (tieneResumen) {
        const matchWA      = respuesta.match(/MENSAJE_WA:\s*([\s\S]+)/);
        const mensajeWA    = matchWA ? limpiarTexto(matchWA[1]) : '';
        const matchResumen = respuesta.match(/RESUMEN:\s*(.+?)(?:\n|$)/);
        const resumen      = matchResumen ? limpiarTexto(matchResumen[1]) : 'Consulta procesada';
        if (!mensajeWA) { agregarMensaje('No pude armar el mensaje. Intentá de nuevo.', 'bot'); return; }
        const waUrl        = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(mensajeWA)}`;

        agregarMensaje(
          `✅ <strong>${escapeHtml(resumen)}</strong><br/><br/>
           <a href="${waUrl}" target="_blank" rel="noopener noreferrer" class="btn-wa-chat">
             <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
               <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
               <path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.535 5.858L.057 23.427a.75.75 0 0 0 .916.916l5.569-1.478A11.95 11.95 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.907 0-3.7-.512-5.243-1.406l-.376-.222-3.896 1.033 1.033-3.896-.222-.376A9.956 9.956 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
             </svg>
             Enviar por WhatsApp
           </a>`,
          'bot',
          true
        );

      } else {
        agregarMensaje(respuesta, 'bot');
      }

    } catch {
      cargando.remove();
      agregarMensaje('Hubo un error. Intentá de nuevo o escribinos directamente por WhatsApp.', 'bot');
    }
  }

  enviar?.addEventListener('click', enviarMensaje);

  input?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      enviarMensaje();
    }
  });
</script>