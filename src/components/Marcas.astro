---
// src/components/Marcas.astro
const marcas = [
  { nombre: 'Sinteplast', src: '/marcas/sinteplast.png',      alt: 'Sinteplast Pinturas' },
  { nombre: 'Urumix',     src: '/marcas/urumix.svg',          alt: 'Urumix Morteros' },
  { nombre: 'Becam',      src: '/marcas/becam.svg',           alt: 'Becam Chapas' },
  { nombre: 'Charrúa',   src: '/marcas/CementoCharrua.png',  alt: 'Cemento Charrúa' },
  { nombre: 'Truper',     src: '/marcas/truper.svg',          alt: 'Truper Herramientas' },
  { nombre: 'EMTOP',      src: '/marcas/emtop.png',           alt: 'EMTOP Herramientas' },
];
---

<section id="marcas" class="section section--gray">
  <div class="container">
    <h2 class="section-title">Marcas que trabajamos</h2>
    <p class="section-subtitle">Productos de calidad de las mejores marcas del mercado.</p>

    <div class="marcas__grid">
      {marcas.map(marca => (
        <div class="marca__item">
          <div class="marca__logo">
            <img src={marca.src} alt={marca.alt} loading="lazy" />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .marcas__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1.5rem;
    margin-top: 2.5rem;
    align-items: center;
  }

  .marca__item {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .marca__logo {
    width: 100%;
    aspect-ratio: 3 / 2;
    background: var(--color-white);
    border: 1px solid var(--color-gray-2);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    filter: grayscale(100%);
    opacity: 0.65;
    transition: filter 0.3s, opacity 0.3s, border-color 0.3s, box-shadow 0.3s;
    cursor: default;
  }

  .marca__logo:hover {
    filter: grayscale(0%);
    opacity: 1;
    border-color: var(--color-brand);
    box-shadow: var(--shadow-sm);
  }

  .marca__logo img {
    max-width: 100%;
    max-height: 60px;
    object-fit: contain;
  }

  @media (max-width: 768px) {
    .marcas__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 400px) {
    .marcas__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
