---
// src/components/Marcas.astro
const marcas = [
  { nombre: 'Marca 1' },
  { nombre: 'Marca 2' },
  { nombre: 'Marca 3' },
  { nombre: 'Marca 4' },
  { nombre: 'Marca 5' },
];
---

<section id="marcas" class="section section--gray">
  <div class="container">
    <h2 class="section-title">Marcas que trabajamos</h2>
    <p class="section-subtitle">Productos de calidad de las mejores marcas del mercado.</p>

    <div class="marcas__grid">
      {marcas.map(marca => (
        <div class="marca__item">
          <div class="marca__logo-placeholder">
            <span>{marca.nombre}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .marcas__grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.5rem;
    margin-top: 2.5rem;
    align-items: center;
  }

  .marca__item {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .marca__logo-placeholder {
    width: 100%;
    aspect-ratio: 3 / 2;
    background: var(--color-gray-2);
    border: 2px dashed var(--color-gray-3);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    filter: grayscale(100%);
    opacity: 0.6;
    transition: filter 0.3s, opacity 0.3s, border-color 0.3s;
    cursor: pointer;
  }

  .marca__logo-placeholder:hover {
    filter: grayscale(0%);
    opacity: 1;
    border-color: var(--color-brand);
  }

  .marca__logo-placeholder span {
    font-size: 0.8rem;
    color: var(--color-gray-4);
    font-weight: 500;
    text-align: center;
  }

  @media (max-width: 768px) {
    .marcas__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 400px) {
    .marcas__grid {
      grid-template-columns: 1fr;
    }
  }
</style>