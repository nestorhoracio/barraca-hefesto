---
// src/components/Header.astro
import logoImg from '../assets/images/logo.jpg';

const navLinks = [
  { href: '#servicios',    label: 'Servicios' },
  { href: '#calculadora',  label: 'Calculadora' },
  { href: '#alquiler',     label: 'Alquiler' },
  { href: '#galeria',      label: 'Galería' },
  { href: '#contacto',     label: 'Contacto' },
];

const WHATSAPP = import.meta.env.WHATSAPP_NUMBER ?? '598543876';
const WA_URL   = `https://wa.me/${WHATSAPP}?text=Hola%20Hefesto%2C%20quisiera%20consultar%20precios.`;
---

<header class="header">
  <div class="container header__inner">

    <a href="/" class="header__logo" aria-label="Barraca Hefesto — inicio">
      <img src={logoImg.src} alt="Logo Barraca Hefesto" class="logo-img" width="44" height="44" />
      <span class="logo-text">HEFESTO</span>
    </a>

    <nav class="header__nav" aria-label="Navegación principal">
      {navLinks.map(link => (
        <a href={link.href} class="nav-link">{link.label}</a>
      ))}
    </nav>
<button class="theme-toggle" id="theme-toggle" aria-label="Cambiar tema">
  <svg id="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
  </svg>
  <svg id="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
  </svg>
</button>
    <a href={WA_URL} target="_blank" rel="noopener noreferrer"
       class="btn btn-primary header__cta">
      Cotizá ya
    </a>

    <!-- Hamburger mobile -->
    <button class="hamburger" id="hamburger" aria-label="Abrir menú" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>

  <!-- Mobile nav -->
  <div class="mobile-nav" id="mobile-nav" aria-hidden="true">
    {navLinks.map(link => (
      <a href={link.href} class="mobile-nav__link">{link.label}</a>
    ))}
    <a href={WA_URL} target="_blank" rel="noopener noreferrer"
       class="btn btn-primary mobile-nav__cta">
      Cotizá por WhatsApp
    </a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-white);
    border-bottom: 1px solid var(--color-gray-2);
    box-shadow: var(--shadow-sm);
  }

  .header__inner {
    display: flex;
    align-items: center;
    height: 64px;
    gap: 1.5rem;
  }

  .header__logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
  }
  .logo-img {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    object-fit: cover;
  }
  .logo-text {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-brand);
    font-family: Georgia, 'Times New Roman', serif;
  }

  /* Nav */
  .header__nav {
    display: flex;
    gap: 0.25rem;
    margin-left: auto;
  }
  .nav-link {
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    color: var(--color-gray-5);
    transition: color 0.15s, background 0.15s;
  }
  .nav-link:hover {
    color: var(--color-brand);
    background: var(--color-brand-bg);
  }

  .header__cta { font-size: 0.9rem; padding: 0.55rem 1.2rem; }
.theme-toggle {
  background: none;
  border: 1px solid var(--color-gray-3);
  border-radius: var(--radius-sm);
  color: var(--color-gray-5);
  cursor: pointer;
  padding: 6px;
  display: flex;
  align-items: center;
  transition: color 0.15s, border-color 0.15s;
}
.theme-toggle:hover {
  color: var(--color-brand);
  border-color: var(--color-brand);
}
#icon-moon { display: none; }
[data-theme="dark"] #icon-sun  { display: none; }
[data-theme="dark"] #icon-moon { display: block; }
  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    margin-left: auto;
  }
  .hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-black);
    border-radius: 2px;
    transition: transform 0.2s;
  }

  /* Mobile nav */
  .mobile-nav {
    display: none;
    flex-direction: column;
    padding: 1rem 1.25rem 1.5rem;
    gap: 0.25rem;
    background: var(--color-white);
    border-top: 1px solid var(--color-gray-2);
  }
  .mobile-nav.open { display: flex; }
  .mobile-nav__link {
    padding: 0.65rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 1rem;
    color: var(--color-gray-5);
  }
  .mobile-nav__link:hover { background: var(--color-gray-1); }
  .mobile-nav__cta { margin-top: 0.75rem; justify-content: center; }

  @media (max-width: 768px) {
    .header__nav, .header__cta { display: none; }
    .hamburger { display: flex; }
  }
</style>

<script>
  const hamburger = document.getElementById('hamburger');
  const mobileNav = document.getElementById('mobile-nav');

  hamburger?.addEventListener('click', () => {
    const isOpen = mobileNav?.classList.toggle('open');
    hamburger.setAttribute('aria-expanded', String(isOpen));
    mobileNav?.setAttribute('aria-hidden', String(!isOpen));
  });

  // Cerrar al hacer click en un link
  mobileNav?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileNav.classList.remove('open');
      hamburger?.setAttribute('aria-expanded', 'false');
    });
  });
  // Dark mode toggle
const toggle = document.getElementById('theme-toggle');
const html   = document.documentElement;

// Al cargar, aplicar preferencia guardada
const saved = localStorage.getItem('theme');
if (saved) html.setAttribute('data-theme', saved);

toggle?.addEventListener('click', () => {
  const isDark = html.getAttribute('data-theme') === 'dark';
  const next   = isDark ? 'light' : 'dark';
  html.setAttribute('data-theme', next);
  localStorage.setItem('theme', next);
});
</script>
