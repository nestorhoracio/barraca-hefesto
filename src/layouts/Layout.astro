---
// src/layouts/Layout.astro
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  preloadImage?: string;
}

const {
  title = 'Barraca Hefesto — Materiales de Construcción en Paso de los Toros',
  description = 'Barraca y ferretería en Paso de los Toros: venta de materiales de construcción, chapas, perfiles y caños, pinturería y alquiler de herramientas, carpas y andamios.',
  ogImage = '/og-image.jpg',
  preloadImage,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const absoluteOgImage = new URL(ogImage, Astro.site);

const localBusinessJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HardwareStore',
  name: 'Barraca Hefesto',
  description: 'Venta de materiales de construcción, chapas, caños y perfiles de hierro, pinturería y alquiler de herramientas, carpas y andamios en Paso de los Toros, Uruguay.',
  image: absoluteOgImage.toString(),
  url: Astro.site?.toString(),
  telephone: '+59899096947',
  email: 'hefestobarraca@gmail.com',
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '18 de Julio 1097 esq. Pedro Mª Chiesa',
    addressLocality: 'Paso de los Toros',
    addressCountry: 'UY',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: -32.81140958843197,
    longitude: -56.526744030475605,
  },
  areaServed: [
    { '@type': 'City', name: 'Paso de los Toros' },
    { '@type': 'City', name: 'Centenario' },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Productos y servicios',
    itemListElement: [
      { '@type': 'OfferCatalog', name: 'Chapas, caños y perfiles' },
      { '@type': 'OfferCatalog', name: 'Aberturas' },
      { '@type': 'OfferCatalog', name: 'Pinturería' },
      { '@type': 'OfferCatalog', name: 'Áridos, bloques y ticholos' },
      { '@type': 'OfferCatalog', name: 'Alquiler de herramientas' },
      { '@type': 'OfferCatalog', name: 'Alquiler de carpas' },
      { '@type': 'OfferCatalog', name: 'Alquiler de andamios' },
    ],
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '08:00', closes: '18:30' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '08:00', closes: '12:00' },
  ],
  sameAs: [
    'https://www.instagram.com/barraca.hefesto/',
    'https://www.instagram.com/hefesto.alquileres/',
    'https://www.facebook.com/barracahefesto',
    'https://www.google.com/maps?cid=5434458253880639823',
  ],
};
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  {preloadImage && <link rel="preload" as="image" fetchpriority="high" href={preloadImage} />}

  <!-- OG / Social -->
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content={absoluteOgImage} />
  <meta property="og:url"         content={canonicalURL} />
  <meta property="og:type"        content="website" />
  <meta property="og:locale"      content="es_UY" />
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={absoluteOgImage} />

  <!-- Structured data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(localBusinessJsonLd)} />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <title>{title}</title>

  <!-- Google Analytics (GA4) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-R2FQBCN7EW"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-R2FQBCN7EW');
  </script>
</head>
<body>
  <slot />

  <!-- Tracking de clicks de WhatsApp y redes sociales en todo el sitio -->
  <script is:inline>
    document.addEventListener('click', function (e) {
      const link = e.target.closest('a[href]');
      if (!link || typeof gtag !== 'function') return;

      const href = link.href;

      if (href.includes('wa.me') || href.includes('api.whatsapp.com')) {
        gtag('event', 'contacto_whatsapp', {
          ubicacion: link.dataset.waLocation || 'otro',
        });
        return;
      }

      let host = '';
      try { host = new URL(href).hostname; } catch { return; }

      if (host.includes('instagram.com') || host.includes('facebook.com')) {
        gtag('event', 'click_red_social', {
          red: host.includes('instagram.com') ? 'instagram' : 'facebook',
          ubicacion: link.dataset.socialLocation || 'otro',
        });
      }
    });
  </script>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
