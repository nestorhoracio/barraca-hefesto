---
// src/layouts/Layout.astro
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  preloadImage?: string;
}

const {
  title = 'Barraca Hefesto — Materiales de Construcción en Paso de los Toros',
  description = 'BARRACA, FERRETERÍA, ALQUILER DE HERRAMIENTAS, TALLER Y REPARACION DE MAQUINARIAS, VENTA DE REPUESTOS en Paso de los Toros, Uruguay.',
  ogImage = '/og-image.jpg',
  preloadImage,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const absoluteOgImage = new URL(ogImage, Astro.site);

const localBusinessJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HardwareStore',
  name: 'Barraca Hefesto',
  image: absoluteOgImage.toString(),
  url: Astro.site?.toString(),
  telephone: '+59899096947',
  email: 'hefestobarraca@gmail.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '18 de Julio 1097 esq. Pedro Mª Chiesa',
    addressLocality: 'Paso de los Toros',
    addressCountry: 'UY',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: -32.81140958843197,
    longitude: -56.526744030475605,
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '08:00', closes: '18:30' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '08:00', closes: '12:00' },
  ],
  sameAs: [
    'https://www.instagram.com/barraca.hefesto/',
    'https://www.instagram.com/hefesto.alquileres/',
    'https://www.facebook.com/barracahefesto',
  ],
};
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  {preloadImage && <link rel="preload" as="image" fetchpriority="high" href={preloadImage} />}

  <!-- OG / Social -->
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content={absoluteOgImage} />
  <meta property="og:url"         content={canonicalURL} />
  <meta property="og:type"        content="website" />
  <meta property="og:locale"      content="es_UY" />
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={absoluteOgImage} />

  <!-- Structured data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(localBusinessJsonLd)} />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <title>{title}</title>
</head>
<body>
  <slot />
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
