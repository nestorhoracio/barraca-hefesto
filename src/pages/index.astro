---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import bannerImg from '../assets/images/banner.jpg';

const WHATSAPP = import.meta.env.WHATSAPP_NUMBER ?? '598099000000';
---

<Layout>
  <Header />

  <main>

    <!-- ==================== HERO ==================== -->
    <section id="hero" class="hero" style={`background-image: url(${bannerImg.src})`}>
      <div class="hero__overlay"></div>
      <div class="container hero__inner">
        <div class="hero__content">
          <p class="hero__eyebrow">Paso de los Toros, Uruguay</p>
          <h1 class="hero__title">
            Todo para<br />
            <span class="hero__highlight">tu obra.</span>
          </h1>
          <p class="hero__sub">
            Materiales de construcción, chapas, aberturas, pinturería
            y alquiler de herramientas y carpas.
          </p>
          <div class="hero__actions">
            <a
              href={`https://wa.me/${WHATSAPP}?text=Hola%20Hefesto%2C%20quiero%20cotizar.`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary"
            >
              Cotizá por WhatsApp
            </a>
            <a href="#calculadora" class="btn btn-white">
              Calculadora de materiales
            </a>
          </div>
          <div class="hero__badges">
            <span class="badge">Alquiler de herramientas</span>
            <span class="badge">Alquiler de carpas</span>
            <span class="badge">Andamios</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== SERVICIOS ==================== -->
    <section id="servicios" class="section">
      <div class="container">
        <h2 class="section-title">Nuestros servicios</h2>
        <p class="section-subtitle">Todo lo que necesitás para tu proyecto, en un solo lugar.</p>
        <!-- TODO: <Servicios /> -->
        <p style="margin-top:2rem; color: var(--color-gray-4);">[Componente Servicios — próxima iteración]</p>
      </div>
    </section>

    <!-- ==================== CALCULADORA ==================== -->
    <section id="calculadora" class="section section--gray">
      <div class="container">
        <h2 class="section-title">Calculadora de materiales</h2>
        <p class="section-subtitle">Calculá exactamente cuánto necesitás antes de venir.</p>
        <!-- TODO: <Calculadora /> -->
        <p style="margin-top:2rem; color: var(--color-gray-4);">[Componente Calculadora — próxima iteración]</p>
      </div>
    </section>

    <!-- ==================== ALQUILER ==================== -->
    <section id="alquiler" class="section">
      <div class="container">
        <h2 class="section-title">Alquiler</h2>
        <p class="section-subtitle">Herramientas y carpas disponibles para alquilar.</p>
        <!-- TODO: <Alquiler /> -->
        <p style="margin-top:2rem; color: var(--color-gray-4);">[Componente Alquiler — próxima iteración]</p>
      </div>
    </section>

    <!-- ==================== GALERÍA ==================== -->
    <section id="galeria" class="section section--gray">
      <div class="container">
        <h2 class="section-title">Galería</h2>
        <p class="section-subtitle">Productos y obras realizadas con materiales Hefesto.</p>
        <!-- TODO: <Galeria /> -->
        <p style="margin-top:2rem; color: var(--color-gray-4);">[Componente Galería — próxima iteración]</p>
      </div>
    </section>

    <!-- ==================== NOSOTROS ==================== -->
    <section id="nosotros" class="section">
      <div class="container">
        <h2 class="section-title">¿Quiénes somos?</h2>
        <!-- TODO: <Nosotros /> -->
        <p style="margin-top:2rem; color: var(--color-gray-4);">[Componente Nosotros — próxima iteración]</p>
      </div>
    </section>

    <!-- ==================== CONTACTO ==================== -->
    <section id="contacto" class="section section--gray">
      <div class="container">
        <h2 class="section-title">Contacto y ubicación</h2>
        <!-- TODO: <Contacto /> -->
        <p style="margin-top:2rem; color: var(--color-gray-4);">[Componente Contacto — próxima iteración]</p>
      </div>
    </section>

    <!-- ==================== ASISTENTE IA ==================== -->
    <!-- Widget flotante — se monta vía script -->
    <!-- TODO: <Asistente /> -->

  </main>

  <Footer />
</Layout>

<style>
  /* Hero */
  .hero {
    position: relative;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    padding: 6rem 0 7rem;
    overflow: hidden;
  }
  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(160, 20, 160, 0.82) 0%,
      rgba(180, 30, 180, 0.70) 50%,
      rgba(140, 10, 140, 0.60) 100%
    );
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: 620px;
  }
  .hero__eyebrow {
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.85);
    margin-bottom: 0.75rem;
  }
  .hero__title {
    font-size: clamp(2.8rem, 7vw, 4.5rem);
    font-weight: 900;
    line-height: 1.05;
    color: var(--color-white);
  }
  .hero__highlight {
    color: var(--color-white);
    text-shadow: 0 0 40px rgba(255,255,255,0.3);
  }
  .hero__sub {
    font-size: 1.1rem;
    color: rgba(255,255,255,0.88);
    margin: 1.25rem 0 2rem;
    max-width: 440px;
    line-height: 1.65;
  }
  .hero__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .btn-white {
    background: rgba(255,255,255,0.15);
    color: var(--color-white);
    border: 2px solid rgba(255,255,255,0.6);
    backdrop-filter: blur(4px);
  }
  .btn-white:hover {
    background: rgba(255,255,255,0.25);
    border-color: var(--color-white);
  }
  .hero__badges {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.75rem;
    flex-wrap: wrap;
  }
  .badge {
    display: inline-block;
    padding: 0.3rem 0.85rem;
    background: rgba(255,255,255,0.15);
    color: var(--color-white);
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 500;
    border: 1px solid rgba(255,255,255,0.4);
    backdrop-filter: blur(4px);
  }

  /* Sections */
  .section { padding: var(--section-py) 0; }
  .section--gray { background: var(--color-gray-1); }

  @media (max-width: 768px) {
    .hero { padding: 4rem 0 5rem; }
    .hero__actions { flex-direction: column; }
    .hero__actions .btn { justify-content: center; }
  }
</style>
