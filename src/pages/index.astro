---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import bannerImg from '../assets/images/banner.jpg';
import Servicios from '../components/Servicios.astro';
import Calculadora from '../components/Calculadora.astro';
import Alquiler from '../components/Alquiler.astro';
import Galeria from '../components/Galeria.astro';
import Marcas from '../components/Marcas.astro';
import Contacto from '../components/Contacto.astro';
import Nosotros from '../components/Nosotros.astro';
import Asistente from '../components/Asistente.astro';

const WHATSAPP = import.meta.env.WHATSAPP_NUMBER ?? '59899096947';
---

<Layout>
  <Header />

  <main>

    <!-- ==================== HERO ==================== -->
    <section id="hero" class="hero" style={`background-image: url(${bannerImg.src})`}>
      <div class="hero__overlay"></div>
      <div class="container hero__inner">
        <div class="hero__content">
          <p class="hero__eyebrow">Paso de los Toros, Uruguay</p>
          <h1 class="hero__title">
            Todo para<br />
            <span class="hero__highlight">tu obra.</span>
          </h1>
          <p class="hero__slogan">Construyendo ideas</p>
          <p class="hero__sub">
            Materiales de construcción, chapas, aberturas, pinturería
            y alquiler de herramientas y carpas.
          </p>
          <div class="hero__actions">
            <a
              href={`https://wa.me/${WHATSAPP}?text=Hola%20Hefesto%2C%20quiero%20cotizar.`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-whatsapp"
            ><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
  <path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.535 5.858L.057 23.427a.75.75 0 0 0 .916.916l5.569-1.478A11.95 11.95 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.907 0-3.7-.512-5.243-1.406l-.376-.222-3.896 1.033 1.033-3.896-.222-.376A9.956 9.956 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
</svg>
Cotizá por WhatsApp
            </a>
            <a href="#calculadora" class="btn btn-white">
              Calculadora de materiales
            </a>
          </div>
          <div class="hero__badges">
            <span class="badge">Alquiler de herramientas</span>
            <span class="badge">Alquiler de carpas</span>
            <span class="badge">Andamios</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== SERVICIOS ==================== -->
    <Servicios />

    <!-- ==================== CALCULADORA ==================== -->
    <Calculadora />

    <!-- ==================== ALQUILER ==================== -->
   <Alquiler />

    <!-- ==================== GALERÍA ==================== -->
    <Galeria />
<!-- ==================== Marcas ==================== -->
    <Marcas />
    <!-- ==================== NOSOTROS ==================== -->
   <Nosotros />

    <!-- ==================== CONTACTO ==================== -->
    <Contacto />

    <!-- ==================== ASISTENTE IA ==================== -->
   <Asistente />

  </main>

  <Footer />
</Layout>

<style>
  /* Hero */
  .hero {
    position: relative;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    padding: 6rem 0 7rem;
    overflow: hidden;
  }
  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(160, 20, 160, 0.92) 0%,
      rgba(180, 30, 180, 0.80) 50%,
      rgba(140, 10, 140, 0.70) 100%
    );
  }
  [data-theme="dark"] .hero__overlay {
  background: linear-gradient(
    135deg,
    rgba(100, 10, 100, 0.92) 0%,
    rgba(120, 15, 120, 0.85) 50%,
    rgba(90, 5, 90, 0.80) 100%
  );
}
  .hero__inner {
  position: relative;
  z-index: 1;
  max-width: 620px;
  margin-left: 0;
}
  .hero__eyebrow {
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.85);
    margin-bottom: 0.75rem;
  }
  .hero__title {
    font-size: clamp(2.8rem, 7vw, 4.5rem);
    font-weight: 900;
    line-height: 1.05;
    color: var(--color-white);
  }
  .hero__highlight {
    color: var(--color-white);
    text-shadow: 0 0 40px rgba(255,255,255,0.3);
  }
  .hero__slogan {
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-top: 0.6rem;
    opacity: 0.9;
  }
  .hero__sub {
    font-size: 1.1rem;
    color: #ffffff;
    margin: 1.25rem 0 2rem;
    max-width: 440px;
    line-height: 1.65;
    font-weight: 500;
  }
  .hero__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .btn-white {
    background: rgba(255,255,255,0.15);
    color: var(--color-white);
    border: 2px solid rgba(255,255,255,0.6);
    backdrop-filter: blur(4px);
  }
  .btn-white:hover {
    background: rgba(255,255,255,0.25);
    border-color: var(--color-white);
  }
 
  .hero__badges {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.75rem;
    flex-wrap: wrap;
  }
  .badge {
    display: inline-block;
    padding: 0.3rem 0.85rem;
    background: rgba(255,255,255,0.15);
    color: var(--color-white);
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 500;
    border: 1px solid rgba(255,255,255,0.4);
    backdrop-filter: blur(4px);
  }

  /* Sections */
  .section { padding: var(--section-py) 0; }
  .section--gray { background: var(--color-gray-1); }

  @media (max-width: 768px) {
    .hero { padding: 4rem 0 5rem; }
    .hero__actions { flex-direction: column; }
    .hero__actions .btn { justify-content: center; }
  }
</style>
